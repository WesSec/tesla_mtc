MODE=DRY
LOG_LEVEL=INFO
TESLA_VIN=YOURVIN
TESLA_REFRESH_TOKEN=REFRESH_TOKEN
DEVICE_COUNTRY=NL
DEVICE_LANGUAGE=nl
IBAN=YOURIBAN
MTC_USERNAME=your.email@example.com
MTC_PASSWORD=yourpassword
# Max sessions to fetch from Tesla
MAX_SESSIONS=12
# Lookback period (in months) in MTC: MAKE SURE YOUR LAST MAX_SESSIONS ARE IN THIS TIMEFRAME TO PREVENT DUPLICATES!
LOOKBACK_PERIOD=6
# Max MTC transactions fetched for the duplicate check; must cover the whole LOOKBACK_PERIOD.
# When MTC returns exactly this many, older sessions are reported instead of submitted.
MTC_MAX_RECORDS=400
# Sessions older than this many days are never submitted automatically, only reported (0 = no limit)
MAX_SESSION_AGE_DAYS=60
TTP_LOCALE=nl_NL
# Action to take when a session has an unknown country (not in the country mapping): SKIP, DUTCH (reimburses as dutch invoice, could be a compliance risk)
UNKNOWN_COUNTRY_ACTION=SKIP
# no need to change these, unless you know what you're doing
TESLA_CLIENT_ID=ownerapi
TESLA_AUTH_URL=https://auth.tesla.com/oauth2/v3
TESLA_API_URL=https://akamai-apigateway-charging-ownership.tesla.com
TESLA_INVOICE_URL=https://ownership.tesla.com/mobile-app/charging/invoice
TESLA_USER_AGENT=TeslaApp/4.39.0-3019/8d0298041d/android/28